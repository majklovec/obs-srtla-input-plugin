{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ubuntu-x86_64",
      "displayName": "Ubuntu x86_64",
      "description": "Build the plugin on Linux using the OBS plugin template setup",
      "binaryDir": "${sourceDir}/build_x86_64",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_LIBDIR": "lib/CMAKE_SYSTEM_PROCESSOR-linux-gnu"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Build the plugin with Visual Studio 2022; downloads obs-deps and builds libobs into .deps on first configure. MSVC warnings are reported but not treated as errors.",
      "binaryDir": "${sourceDir}/build_x64",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ENABLE_FRONTEND_API": false,
        "ENABLE_QT": false,
        "CMAKE_COMPILE_WARNING_AS_ERROR": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ubuntu-x86_64",
      "configurePreset": "ubuntu-x86_64",
      "displayName": "Ubuntu x86_64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64",
      "configuration": "Release"
    }
  ]
}
